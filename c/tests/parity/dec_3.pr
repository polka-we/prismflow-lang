print(1d + "a", "a" + 2.5d)
precision(50)
print(1 / 3, 22 / 7, 10 / 4, 10 / 5)
print(0.1 * 3, 0.7 + 0.1, 1.1 * 1.1)
print([1, 2, 3].avg(), [0.5, 0.25].sum())
print(2 ** 0.5, 2d ** 0.5)
print(float("1.5") + float(2), float(7) / 2)
print(int(7 / 2), 7 / 2 > 3)
s := 0
range(5):: s += 0.1
print(s, s == 0.5)
print(sqrt(2), sqrt(2) * sqrt(2) == 2)
print(round(2 / 3, 4), round(1 / 3))
print(str(1 / 4), `${1 / 8}`)
print(sin(0.5), pi)
print(precision())
precision(5)
print(1 / 3, 2d / 3d)
precision(0)
print(1 / 3, 2d / 3d, 0.1 + 0.2)
