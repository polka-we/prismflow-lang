print(file.exists("a.txt"))
file.write("a.txt", "one\ntwo\nthree\n")
file.append("a.txt", "four\n")
print(file.read("a.txt").len, file.exists("a.txt"))
print(file.lines("a.txt"))
print(file.lines("a.txt") where _.len > 3 select _.upper())
file.write_lines("b.txt", [1, "x", 2.5])
print(file.read("b.txt"))
print(file.list("."))
print(file.delete("b.txt"), file.exists("b.txt"))
x = file.read("missing.txt")
x match
    is error -> print("err:", x.message)
    else -> print("ok")
print(file.read("../etc/passwd"))
print(file.read("/etc/passwd"))
print(file.write("no/dir/x.txt", "q"))
