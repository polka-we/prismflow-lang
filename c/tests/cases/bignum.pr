a = 2 ** 200
b = 3 ** 150
print(a, b)
print(a * b, a + b, a - b, b - a)
print(a % 1000007, div(a, b), a % b, (0 - a) % 1000007, div(0 - a, 12345))
print(div(a * b, a), (a * b) % a, a == a, a == b, a < b, a > b, b > 5)
print(9223372036854775807 + 1, 0 - 9223372036854775807 - 2, 9223372036854775807 * 3)
print(abs(0 - a), min(a, b, 5), max(a, b), [a, b, 1].sum())
print(int("123456789012345678901234567890") + 1, 123456789012345678901234567890 / 10)
print(type(a), a is int, float(a), a ** 2 / b)
print(range(1, 31).reduce(1, _1 * _2))
print((2 ** 64) - (2 ** 64) , type((2 ** 64) - (2 ** 64) + 1))
