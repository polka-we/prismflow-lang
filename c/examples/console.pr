// поле «Заготовленный ввод» пустое: программа ждёт строки в окне вывода
print("Как вас зовут?")
name = request.line()
print(`Привет, {name}!`)

print("Вводите строки (stop или Ctrl+D - конец):")
request.lines()
    .take_while(_ != "stop")
    ::x -> print("получено: " + x.upper())
print("ввод закончен")
