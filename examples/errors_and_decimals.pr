// Errors are values; decimals are exact when you ask for them.
r = 10 / 0
print(r, r ?? "fallback")                    // error("division by zero") fallback
print("abc".to_int() ?? 0)                   // 0
print(0.1 + 0.2 == 0.3, 0.1d + 0.2d == 0.3d) // false true
print(2 ** 100)                              // 1267650600228229401496703205376
