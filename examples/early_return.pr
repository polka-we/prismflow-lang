// `return` inside an `is` branch leaves the whole function, even from nested `::` loops.
// `next` skips an item, `stop` ends the loop.
first_pair n =
    range(n):: i
        range(n):: j
            is i * j == 6 -> return [i, j]
    none
print(first_pair(5), first_pair(2))          // [2, 3] none

total := 0
range(100):: i
    is i % 2 == 0 -> next
    is i > 9 -> stop
    total += i
print(total)                                 // 1 + 3 + 5 + 7 + 9 = 25
